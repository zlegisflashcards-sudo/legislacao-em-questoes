# Segredos somente no servidor. Nunca use NEXT_PUBLIC_ para credenciais Meta/IA.
# disabled: sem recepção/envio; shadow: recebe e prepara rascunhos; live: pode responder.
LEGISDOT_WHATSAPP_MODE=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v27.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Gere um segredo aleatório e configure no chamador do worker.
LEGISDOT_WORKER_TOKEN=

# Piloto: telefone internacional só com dígitos ou BSUID exato, separados por vírgula.
# Telefone também funciona como alias se a Meta o informar junto ao BSUID.
LEGISDOT_WHATSAPP_ALLOWLIST=
LEGISDOT_WHATSAPP_ALLOW_ALL=false
LEGISDOT_MAX_REPLIES_PER_DAY=100

# Reutiliza OPENAI_API_KEY já existente; sem chave, há respostas por regras.
LEGISDOT_OPENAI_MODEL=gpt-5.4-mini

# Já existentes no projeto: NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY e configuração admin.
